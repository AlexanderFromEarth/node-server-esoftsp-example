{
  "name": "srv",
  "version": "1.0.0",
  "main": "app.ts",
  "types": "dist/index.d.ts",
  "scripts": {
    "prestart": "tsc",
    "start": "if [ \"$NODE_ENV\" = \"production\" ]; then fastify start dist/app.js; else concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"tsc -w\" \"fastify start -w -d -I 9229 -l debug -P dist/app.js\"; fi",
    "poststart": "rm -rf dist/",
    "pretest": "tsc && tsc -p test/tsconfig.json",
    "test": "c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "posttest": "rm -rf dist/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/sensible": "^6.0.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@types/pg": "^8.20.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  },
  "description": "This project was bootstrapped with Fastify-CLI.",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderFromEarth/node-server-esoftsp-example.git"
  },
  "bugs": {
    "url": "https://github.com/AlexanderFromEarth/node-server-esoftsp-example/issues"
  },
  "homepage": "https://github.com/AlexanderFromEarth/node-server-esoftsp-example#readme"
}
